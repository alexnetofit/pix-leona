# Configurações de API - NÃO COMMITAR O ARQUIVO .env REAL!

# Chave secreta da Stripe (começa com sk_)
STRIPE_SECRET=sk_live_sua_chave_aqui

# Chave de API do AbacatePay v1 (usada para criar PIX e verificar status)
ABACATEPAY_KEY=abc_prod_sua_chave_v1_aqui

# Chave de API do AbacatePay v2 (usada para buscar checkouts por email/CPF)
ABACATEPAY_KEY_V2=abc_prod_sua_chave_v2_aqui

# Token da Guru (User Token para API v2 - busca assinaturas, contatos, transações)
GURU_TOKEN=seu_user_token_guru_aqui

# Token do webhook de afiliados (mesmo GURU_WEBHOOK_API_TOKEN do afiliados-leona).
# Sem ele, venda Pagou libera a Leona mas a comissão não cai no painel do parceiro.
GURU_WEBHOOK_API_TOKEN=seu_token_webhook_afiliados_aqui

# Token de integração do Leona (INTEGRATION_BILLING_BEARER_TOKEN - busca billing profile)
LEONA_BILLING_TOKEN=seu_token_leona_aqui

# Chave de API da Paddle (Bearer token para API REST)
PADDLE_API_KEY=sua_chave_paddle_aqui

# Client token publico Paddle (usado pelo Paddle.js no /checkout)
PADDLE_CLIENT_TOKEN=live_xxxx
# Ambiente Paddle (production ou sandbox; obrigatório)
PADDLE_ENVIRONMENT=production
# Webhook secret HMAC pra validar payloads do Paddle
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
# Price ID do plano Starter mensal por conexão (opcional).
# Se vazio, o checkout internacional acha o produto Starter/Leona Flow no catálogo.
PADDLE_STARTER_PRICE_ID=pri_xxx
# Price ID one-time em BRL usado nos checkouts PIX Paddle
PADDLE_PIX_PRICE_ID=pri_xxx
# Discounts salvos para PATCH de subscriptions (opcional; se ausentes, o
# backend cria e guarda IDs por conta no ledger).
PADDLE_DISCOUNT_2_3_ID=dsc_xxx
PADDLE_DISCOUNT_4_PLUS_ID=dsc_xxx

# === PADDLE-FIRST: IDENTIDADE, SESSAO E WORKERS ===
# Segredo HMAC (32+ bytes aleatorios) que assina tickets e cookies do /paddle.
# OBRIGATORIO: sem ele /api/paddle-search e /api/paddle-subscription respondem
# 503 e as paginas de assinatura param de abrir.
PADDLE_LINK_SECRET=cole_aqui_um_segredo_hmac_longo
# Bearer server-to-server usado pelo Leona para emitir links assinados
PADDLE_LINK_ISSUER_TOKEN=cole_aqui_um_token_issuer_longo
# URL publica da experiencia Paddle. Facilita migrar /paddle -> /assinatura.
PADDLE_BILLING_BASE_URL=https://client.leonaflow.com/paddle
# URL do checkout inline vinculado à transaction preparada no servidor.
PADDLE_CHECKOUT_BASE_URL=https://client.leonaflow.com/checkout
# Aceita links antigos (account_id+email) na abertura de sessao. Precisa ficar
# true enquanto o painel do Leona nao gerar link via /api/paddle-link; em false
# so ticket assinado abre sessao, que e o estado que fecha o acesso por e-mail.
PADDLE_ALLOW_LEGACY_LINKS=false
# Segredo enviado automaticamente pelo Vercel Cron ao worker/reconciler.
CRON_SECRET=cole_aqui_um_token_cron_longo

# === CHAT IA DE SUPORTE (/chat) ===
# Chave da OpenAI (sk-...)
OPENAI_API_KEY=sk-xxx
# Modelo OpenAI usado pelo chat de suporte
OPENAI_MODEL=gpt-5.4-mini
# Token de acesso ao /chat e a pagina /suporte (qualquer string aleatoria, mais segura == melhor)
SUPPORT_CHAT_TOKEN=cole_aqui_um_token_aleatorio_longo

# === AUTH / CORS DOS ENDPOINTS api/* ===
# Token admin do portal interno (login em /portal). Tambem usado como Bearer
# em endpoints de mutacao (update-subscription, simulate-upgrade, abacatepay-refund).
TOKEN_ADMIN=cole_aqui_um_token_admin_aleatorio_longo

# Whitelist de origins permitidos (separados por virgula). Se vazio,
# o CORS volta a ser '*' (compativel com setup antigo). Em producao,
# liste apenas os dominios reais do front:
#   CORS_ALLOWED_ORIGINS=https://client.leonaflow.com,https://gerador-pix-leona.vercel.app
CORS_ALLOWED_ORIGINS=

# Modo de enforcement da auth admin nos endpoints de mutacao:
#   warn  -> so loga falhas (default — rollout seguro)
#   deny  -> rejeita com 401 quem nao mandar Authorization: Bearer <TOKEN_ADMIN>
# Comece em warn, monitore os logs por 1-2 dias, depois mude pra deny.
AUTH_ENFORCEMENT=warn

# === SUPABASE ===
# ATENCAO: existe um SUPABASE_URL so, mas o codigo referencia tabelas em dois
# projetos diferentes. Hoje aponta pro "Leona Billing", que e onde estao
# revenue_daily (cache de faturamento da tela /guru) e as tabelas paddle_*.
#
# A tabela support_actions (fila de aprovacao de /suporte e /admin) vive no
# projeto "Afiliados Leona" (teklbteabwcgceemvdhd), ou seja, fica fora do
# alcance enquanto o apontamento for este. Pra fila voltar a funcionar, ou a
# tabela e recriada no projeto Leona Billing, ou o modulo passa a ter
# credencial propria.
#
# Esses 2 valores ficam em Supabase Dashboard > Settings > API Keys.
SUPABASE_URL=https://qlfieymaalnemmnhxgti.supabase.co

# IMPORTANTE: usar a service_role key (NAO a anon/publishable). RLS esta
# habilitada nas tabelas sem policies, entao so service_role le/escreve.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key_aqui...

# === PAGAR.ME (Trilha de premiação) ===
# Secret Key (sk_...). Cloud usa PAGARME_KEY; PAGARME_API_KEY é fallback legado.
PAGARME_KEY=
PAGARME_API_KEY=

# Ponto Hub / Pontoplacas — emite o resgate depois do pagamento da trilha
PONTO_HUB_API_KEY=

# === DLOCAL GO ===
# Live: Authorization Bearer <API_KEY>:<SECRET_KEY> em https://api.dlocalgo.com
# Webhook: https://client.leonaflow.com/api/webhook-dlocal-go
DLOCAL_GO_API_KEY=
DLOCAL_GO_SECRET_KEY=
DLOCAL_GO_MERCHANT_ID=

# === COBRANCA PADDLE-FIRST ===
# Trava mestra do ledger Paddle (webhook -> intents -> outbox -> reconcile).
# Enquanto nao for "true" o lib/paddle-ledger.js recusa qualquer acesso e os
# crons paddle-* respondem sem fazer nada. Existe pra permitir usar o Supabase
# em outras features sem despertar a cobranca automatica por acidente.
PADDLE_FIRST_ENABLED=false
